DOCSIFTER_GITHUB_TOKEN=
DOCSIFTER_INSTALL_MODEL_RUNTIME=false
DOCSIFTER_DATA_DIR=./data
# History, monitor logs, and report files older than this are removed at web
# startup. Set retention_days to 0 in config.json to keep everything.

# Model weights are ~3.1 GB. Point Hugging Face at a roomier volume when the
# system disk is tight; both variables must agree.
# HF_HOME=/Volumes/YourDisk/docsifter/model-cache/huggingface
# HUGGINGFACE_HUB_CACHE=/Volumes/YourDisk/docsifter/model-cache/huggingface/hub
# Separate multiple roots with the operating system path separator (: on macOS/Linux).
DOCSIFTER_ALLOWED_ROOTS=.
# Set this when GitHub must call the webhook through a public URL.
DOCSIFTER_PUBLIC_URL=
DOCSIFTER_ADMIN_TOKEN=

# Correction model backend: local (transformers via pycorrector), ollama, or openai.
# For ollama/openai backends the model id is not restricted to the curated local list.
DOCSIFTER_MODEL_BACKEND=local
DOCSIFTER_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Required when DOCSIFTER_MODEL_BACKEND=openai, for example https://api.openai.com/v1
DOCSIFTER_OPENAI_BASE_URL=
DOCSIFTER_OPENAI_API_KEY=

# Optional second-pass LLM review (OpenAI-compatible chat completions endpoint).
# The key is kept in memory only and never written back to config.json.
DOCSIFTER_LLM_REVIEW_ENABLED=false
DOCSIFTER_LLM_ENDPOINT=
DOCSIFTER_LLM_MODEL=
DOCSIFTER_LLM_API_KEY=

# Optional cross-line context review; reuses the LLM endpoint settings above.
# Finds terminology inconsistency, contradictions, and broken cross-references.
# This layer sends one whole document per file. context_review_scope defaults to
# "flagged", reviewing only files that already have findings so cost follows
# findings; "all" reviews every file and cost follows document count. Either way
# context_max_files (default 50) caps one run.
DOCSIFTER_CONTEXT_REVIEW_ENABLED=false
DOCSIFTER_CONTEXT_REVIEW_SCOPE=flagged

# Both layers above apply to CLI and Web reviews only. Webhook-triggered pull
# request reviews run unattended and opt in separately. This is a path switch,
# not a third layer: the two switches above still decide what actually runs.
DOCSIFTER_PR_LLM_ENABLED=false

# Logging: text (default) or json single-line records.
DOCSIFTER_LOG_FORMAT=text
DOCSIFTER_LOG_LEVEL=INFO

DOCSIFTER_EMAIL_SMTP_SERVER=
DOCSIFTER_EMAIL_SMTP_PORT=587
DOCSIFTER_EMAIL_USERNAME=
DOCSIFTER_EMAIL_PASSWORD=
DOCSIFTER_EMAIL_SENDER=
DOCSIFTER_EMAIL_RECIPIENTS=
DOCSIFTER_EMAIL_NOTIFICATIONS_ENABLED=false
# Reports larger than this (after base64 encoding) are left off the notification
# rather than pushing the message past the provider limit. Set in config.json or
# the Web UI: email_max_attachment_mb (default 10).
